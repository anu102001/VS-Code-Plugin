{
  "name": "firebase-plugin",
  "displayName": "Firebase Plugin",
  "description": "Plugin to connect and save file with Firebase",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "firebase-plugin.helloWorld",
        "title": "Start Firebase Plugin"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "firebasePlugin",
          "name": "Firebase Plugin"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "firebase": "^11.2.0",
    "open": "^10.1.0"
  }
}